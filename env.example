# Golem Telegram Bot Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Telegram Bot Token (required)
# Get this from @BotFather on Telegram
# Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Who may use the bot: Telegram user IDs (numbers), separated by commas.
# Everyone else is told "this is a private assistant" and their user ID, so
# to find your own ID, start the bot without this and send it a message.
# The bot can reach your calendar and lists, so keep this list short.
TELEGRAM_ALLOWED_USERS=

# Who may run /reload (default: every allowed user). Must also be allowed.
# TELEGRAM_ADMINS=

# Let anyone on Telegram use the bot. Only for a bot with nothing private
# behind it; /reload then needs TELEGRAM_ADMINS.
# TELEGRAM_ALLOW_ALL=false

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Enable verbose logging (true/false)
# Default: false
VERBOSE=false

# Timezone for the container
# Default: UTC
# Examples: America/New_York, Europe/London, Asia/Tokyo
TZ=UTC

# =============================================================================
# WHAT THE BOT REMEMBERS ABOUT USERS
# =============================================================================

# Each user's name, location, saved list credentials and other user_*
# predicates are kept in USER_STORE_PATH, and reminders in REMINDERS_PATH
# (see ASSISTANT_FEATURES.md). In Docker both are in the golem-data volume.
# USER_STORE_PATH=data/users.json
# REMINDERS_PATH=data/reminders.json

# Encrypts passwords and other secrets in the user store. Strongly
# recommended: any long random string, e.g. from `openssl rand -base64 32`.
# Keep it safe; without it, saved passwords can't be read back.
# USER_STORE_KEY=

# =============================================================================
# EXTRA AIML FROM A GIT REPOSITORY (optional)
# =============================================================================

# Fetched before the bot starts and loaded with the bundled AIML
# (see docker/sync-aiml.sh)
# AIML_REPO=https://github.com/you/your-aiml.git
# AIML_REF=main
# For a private repository: a GitHub fine-grained token with read-only
# Contents access to that repository only
# AIML_TOKEN=

# =============================================================================
# EXTERNAL SERVICES (optional; the bot falls back politely without them)
# =============================================================================

# Weather and forecasts (https://pirateweather.net)
# PIRATE_WEATHER_API_KEY=

# List handler service
# LIST_HANDLER_URL=

# CalDAV calendar, e.g. Radicale (see CALDAV_INTEGRATION.md). The bot uses
# RADICALE_URL/RADICALE_USER/RADICALE_CALENDAR/, so split a full calendar URL:
#   https://box.example.org/radicale/alice/fb88f562-.../  becomes
#   RADICALE_URL=https://box.example.org/radicale  RADICALE_USER=alice
#   RADICALE_CALENDAR=fb88f562-...  (the calendar's ID, not its display name)
# RADICALE_URL=http://radicale:5232
# RADICALE_USER=
# RADICALE_PASSWORD=
# RADICALE_CALENDAR=personal

# =============================================================================
# WIKIPEDIA ("what is ...", "who was ...", "tell me about ...")
# =============================================================================

# Works without a key. Wikimedia asks every client to send a User-Agent with
# a way to contact its owner, and throttles those without one, so set it:
# WIKIPEDIA_USER_AGENT=my-assistant/1.0 (you@example.com)
# Another language's Wikipedia (default English):
# WIKIPEDIA_URL=https://de.wikipedia.org/w/api.php

# =============================================================================
# SEARXNG (sums, conversions: "what is 15% of 80", "5 miles in km"; "search for ...")
# =============================================================================

# Your SearXNG instance, as the bot's container reaches it (a LAN address, or
# the service name if it's on the same Docker network). Its settings.yml must
# allow the JSON format:  search: formats: [html, json]
# SEARX_URL=http://192.168.1.10:8888

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Custom AIML path (if not using the default testdata)
# Default: ./testdata (mounted as volume)
# AIML_PATH=/custom/path/to/aiml/files

# =============================================================================
# MONITORING CONFIGURATION (Optional)
# =============================================================================

# Uncomment these if you want to enable monitoring services
# PROMETHEUS_ENABLED=true
# LOKI_ENABLED=true

# =============================================================================
# DOCKER COMPOSE PROFILES
# =============================================================================

# To run with monitoring services:
# docker-compose --profile monitoring up -d

# To run only the bot:
# docker-compose up -d
