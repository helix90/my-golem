<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
    <!--
      CalDAV/Radicale Calendar Integration Examples

      Needs the caldav_* SRAIX services from caldav-config.properties. Each
      service's fallback is what <sraix> returns when the calendar cannot be
      reached, or (for get and delete) when no single event matches.
    -->

    <!-- List Today's Events -->
    <category>
        <pattern>WHAT IS ON MY CALENDAR TODAY</pattern>
        <template>
            <think>
                <set var="events"><sraix service="caldav_today">today</sraix></set>
            </think>
            <condition var="events">
                <li value="">You have no events scheduled for today.</li>
                <li value="Unable to retrieve calendar events">I'm having trouble accessing your calendar right now.</li>
                <li>Here are your events for today: <get var="events"/></li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>SHOW MY CALENDAR</pattern>
        <template>
            <srai>WHAT IS ON MY CALENDAR TODAY</srai>
        </template>
    </category>

    <category>
        <pattern>WHAT DO I HAVE TODAY</pattern>
        <template>
            <srai>WHAT IS ON MY CALENDAR TODAY</srai>
        </template>
    </category>

    <!-- List Upcoming Events -->
    <category>
        <pattern>WHAT IS ON MY CALENDAR</pattern>
        <template>
            <think>
                <set var="events"><sraix service="caldav_list">upcoming</sraix></set>
            </think>
            <condition var="events">
                <li value="">You have no events in the next seven days.</li>
                <li value="Unable to retrieve calendar events">I'm having trouble accessing your calendar right now.</li>
                <li>Here are your upcoming events: <get var="events"/></li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>SHOW MY UPCOMING EVENTS</pattern>
        <template>
            <srai>WHAT IS ON MY CALENDAR</srai>
        </template>
    </category>

    <!-- Create New Event: the text gives the title, date, time and length,
         e.g. "Lunch with Sam tomorrow at noon for 90 minutes" -->
    <category>
        <pattern>CREATE EVENT *</pattern>
        <template>
            <think>
                <set var="created"><sraix service="caldav_create"><star/></sraix></set>
            </think>
            <condition var="created">
                <li value="Failed to create calendar event">I was unable to create that event. Please try again.</li>
                <li>Event created: <get var="created"/></li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>ADD EVENT *</pattern>
        <template>
            <srai>CREATE EVENT <star/></srai>
        </template>
    </category>

    <category>
        <pattern>SCHEDULE *</pattern>
        <template>
            <srai>CREATE EVENT <star/></srai>
        </template>
    </category>

    <category>
        <pattern>CREATE EVENT CALLED * ON * AT *</pattern>
        <template>
            <srai>CREATE EVENT <star index="1"/> on <star index="2"/> at <star index="3"/></srai>
        </template>
    </category>

    <!-- Get Specific Event, by title or UID -->
    <category>
        <pattern>GET EVENT *</pattern>
        <template>
            <think>
                <set var="event"><sraix service="caldav_get"><star/></sraix></set>
            </think>
            <condition var="event">
                <li value="Event not found">I couldn't find a single event matching "<star/>".</li>
                <li>Event details: <get var="event"/></li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>SHOW EVENT *</pattern>
        <template>
            <srai>GET EVENT <star/></srai>
        </template>
    </category>

    <!-- Delete Event, by title or UID. A repeating event is deleted with all
         its occurrences. -->
    <category>
        <pattern>DELETE EVENT *</pattern>
        <template>
            <think>
                <set var="deleted"><sraix service="caldav_delete"><star/></sraix></set>
            </think>
            <condition var="deleted">
                <li value="Failed to delete event">I couldn't delete that event. Check that exactly one event matches "<star/>".</li>
                <li>Event deleted: <get var="deleted"/></li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>REMOVE EVENT *</pattern>
        <template>
            <srai>DELETE EVENT <star/></srai>
        </template>
    </category>

    <category>
        <pattern>CANCEL EVENT *</pattern>
        <template>
            <srai>DELETE EVENT <star/></srai>
        </template>
    </category>

    <!-- Calendar Management: the calendar predicate picks the calendar the
         services use; without it they use RADICALE_CALENDAR -->
    <category>
        <pattern>USE CALENDAR *</pattern>
        <template>
            <think>
                <set name="calendar"><star/></set>
            </think>
            Switched to calendar: <get name="calendar"/>
        </template>
    </category>

    <category>
        <pattern>SWITCH TO CALENDAR *</pattern>
        <template>
            <srai>USE CALENDAR <star/></srai>
        </template>
    </category>

    <category>
        <pattern>SET MY CALENDAR TO *</pattern>
        <template>
            <srai>USE CALENDAR <star/></srai>
        </template>
    </category>

    <category>
        <pattern>USE MY DEFAULT CALENDAR</pattern>
        <template>
            <think>
                <set name="calendar"></set>
            </think>
            Switched to your default calendar.
        </template>
    </category>

    <category>
        <pattern>WHAT CALENDAR AM I USING</pattern>
        <template>
            <condition name="calendar">
                <li value="">You are using the default calendar.</li>
                <li>You are currently using the <get name="calendar"/> calendar.</li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>WHICH CALENDAR</pattern>
        <template>
            <srai>WHAT CALENDAR AM I USING</srai>
        </template>
    </category>

    <category>
        <pattern>MY CALENDAR</pattern>
        <template>
            <srai>WHAT CALENDAR AM I USING</srai>
        </template>
    </category>

    <!-- Calendar Status -->
    <category>
        <pattern>IS CALDAV ENABLED</pattern>
        <template>
            <condition name="bot.caldav.enabled">
                <li value="true">Yes, CalDAV integration is enabled. You're connected to <bot name="caldav.server"/>. <srai>WHAT CALENDAR AM I USING</srai></li>
                <li>CalDAV integration is not currently enabled.</li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>CALENDAR STATUS</pattern>
        <template>
            <srai>IS CALDAV ENABLED</srai>
        </template>
    </category>

    <!-- Help -->
    <category>
        <pattern>CALENDAR HELP</pattern>
        <template>
            I can help you manage your calendar. Try these commands:
            - "What is on my calendar today"
            - "Show my upcoming events"
            - "Create event Lunch with Sam tomorrow at noon"
            - "Create event called Review on Friday at 2pm"
            - "Show event Lunch with Sam"
            - "Delete event Lunch with Sam"
            - "Use calendar [name]" - Switch to a different calendar
            - "What calendar am I using" - Show current calendar
            - "Calendar status"
        </template>
    </category>

    <category>
        <pattern>CALDAV HELP</pattern>
        <template>
            <srai>CALENDAR HELP</srai>
        </template>
    </category>

</aiml>
