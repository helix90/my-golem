<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
<!--
  User location, for weather and anything else that needs it

  Predicates: user_location (the place as the user named it),
  user_latitude and user_longitude. Like every user_* predicate they are
  saved per user in the user store, so they survive restarts.

  Earlier versions saved them with <learnf> as "GET LOCATION FOR <user id>"
  categories (and LATITUDE, LONGITUDE), which any user could match.
  MigrateLegacyUserData moves those into the user store at startup.
-->

<category>
<pattern>MY LOCATION IS *</pattern>
<template>
  <think>
    <set var="place"><star/></set>
    <set var="lat"><sraix service="geocode"><get var="place"/></sraix></set>
    <set var="lon"><get name="geocode_lon"/></set>
  </think>
  <condition var="lat">
    <li value="Unable to find that location">I couldn't find that location. Please try again with a city name or address.</li>
    <li value="">I couldn't find that location. Please try again with a city name or address.</li>
    <li>
      <think>
        <set name="user_location"><get var="place"/></set>
        <set name="user_latitude"><get var="lat"/></set>
        <set name="user_longitude"><get var="lon"/></set>
      </think>
      I've set your location to <get name="user_location"/> (coordinates: <get name="user_latitude"/>, <get name="user_longitude"/>). <condition name="telegram_user"><li value=""></li><li>I'll remember it.</li></condition>
    </li>
  </condition>
</template>
</category>

<category><pattern>SET MY LOCATION TO *</pattern><template><srai>MY LOCATION IS <star/></srai></template></category>
<category><pattern>SET LOCATION *</pattern><template><srai>MY LOCATION IS <star/></srai></template></category>
<category><pattern>I LIVE IN *</pattern><template><srai>MY LOCATION IS <star/></srai></template></category>

<!-- Coordinates without geocoding, e.g. from a shared Telegram location.
     The Telegram bot sends "MY COORDINATES ARE <lat> <lon>" when a user
     shares their location. -->
<category>
<pattern>MY COORDINATES ARE * *</pattern>
<template>
  <think>
    <set name="user_latitude"><star/></set>
    <set name="user_longitude"><star index="2"/></set>
    <set name="user_location">your shared location</set>
  </think>
  Thanks! I've saved your location (<get name="user_latitude"/>, <get name="user_longitude"/>), so you can ask me about the weather there.
</template>
</category>

<category>
<pattern>FORGET MY LOCATION</pattern>
<template>
  <think>
    <set name="user_location"></set>
    <set name="user_latitude"></set>
    <set name="user_longitude"></set>
  </think>
  Okay, I've forgotten your location.
</template>
</category>
<category><pattern>CLEAR MY LOCATION</pattern><template><srai>FORGET MY LOCATION</srai></template></category>

<category>
<pattern>WHAT IS MY LOCATION</pattern>
<template>
  <condition name="user_latitude">
    <li value="">You haven't set your location yet. Tell me your location by saying "My location is [city name]".</li>
    <li>Your location is set to <get name="user_location"/> (coordinates: <get name="user_latitude"/>, <get name="user_longitude"/>).</li>
  </condition>
</template>
</category>
<category><pattern>WHERE AM I</pattern><template><srai>WHAT IS MY LOCATION</srai></template></category>

<!-- Kept for AIML that still calls them; the user store loads the location -->
<category><pattern>LOAD MY LOCATION</pattern><template><srai>WHAT IS MY LOCATION</srai></template></category>
<category><pattern>AUTOLOAD LOCATION FOR WEATHER</pattern><template></template></category>

</aiml>
