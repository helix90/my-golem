<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
<!--
  User name

  The name lives in the user_name predicate. When the bot has a user store
  (USER_STORE_PATH) and knows who is talking (the Telegram bot sets each
  session's UserID to the sender), every user_* predicate is saved for that
  user and comes back in later sessions and after restarts. Nothing here
  needs to load or save it.

  Earlier versions saved names with <learnf> as "GET NAME FOR <user id>"
  categories, which any user could match. MigrateLegacyUserData moves those
  into the user store at startup.
-->

<category>
<pattern>MY NAME IS *</pattern>
<template>
  <think><set name="user_name"><star/></set></think>
  Nice to meet you, <get name="user_name"/>! <condition name="telegram_user"><li value=""></li><li>I'll remember that.</li></condition>
</template>
</category>

<category><pattern>SET MY NAME TO *</pattern><template><srai>MY NAME IS <star/></srai></template></category>
<category><pattern>CALL ME *</pattern><template><srai>MY NAME IS <star/></srai></template></category>
<category><pattern>I AM *</pattern><template><srai>MY NAME IS <star/></srai></template></category>
<category><pattern>I M *</pattern><template><srai>MY NAME IS <star/></srai></template></category>

<category>
<pattern>FORGET MY NAME</pattern>
<template>
  <think><set name="user_name"></set></think>
  Okay, I've forgotten your name.
</template>
</category>
<category><pattern>CLEAR MY NAME</pattern><template><srai>FORGET MY NAME</srai></template></category>

<category>
<pattern>WHAT IS MY NAME</pattern>
<template>
  <condition name="user_name">
    <li value="">You haven't told me your name yet. Tell me your name by saying "My name is [your name]".</li>
    <li>Your name is <get name="user_name"/>.</li>
  </condition>
</template>
</category>
<category><pattern>WHO AM I</pattern><template><srai>WHAT IS MY NAME</srai></template></category>
<category><pattern>WHAT S MY NAME</pattern><template><srai>WHAT IS MY NAME</srai></template></category>
<category><pattern>DO YOU KNOW MY NAME</pattern><template><srai>WHAT IS MY NAME</srai></template></category>
<category><pattern>DO YOU REMEMBER MY NAME</pattern><template><srai>WHAT IS MY NAME</srai></template></category>

<!-- Kept for AIML that still calls them; the user store loads the name -->
<category><pattern>LOAD MY NAME</pattern><template><srai>WHAT IS MY NAME</srai></template></category>
<category><pattern>AUTOLOAD NAME</pattern><template></template></category>

</aiml>
