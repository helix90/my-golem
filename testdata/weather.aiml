<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
<!--
  Weather Integration using Pirate Weather API

  Features:
  - Query current weather for default user location
  - Query current weather for specified location
  - Query tomorrow's forecast for user location
  - Query tomorrow's forecast for specified location
  - Set user's default location
  - Geocoding support for location names

  Configuration:
  - Load weather-config.properties for SRAIX service configuration
  - Set PIRATE_WEATHER_API_KEY environment variable

  Example usage:
  - "What's the weather?"
  - "What's the weather in San Francisco?"
  - "What's the weather tomorrow?"
  - "What's the weather tomorrow in Seattle?"
  - "My location is Boston"
  - "Set my location to Portland Oregon"
-->

<!-- Location setting patterns moved to user-location-persistence.aiml for persistence support -->
<!-- The following patterns are now handled by user-location-persistence.aiml:
     - MY LOCATION IS *
     - SET MY LOCATION TO *
     - SET LOCATION *
-->

<!-- Query weather for user's default location -->
<category>
<pattern>WHAT IS THE WEATHER</pattern>
<template>
  <think>

    <set var="lat"><get name="user_latitude"/></set>
    <set var="lon"><get name="user_longitude"/></set>
  </think>

  <!-- Check if location is set -->
  <condition>
    <li var="lat" value="">You haven't set your location yet. Tell me by saying "My location is [city name]", or share it. <reply><text>📍 Share my location</text><location/></reply></li>
    <li var="lat" value="0.0">You haven't set your location yet. Tell me by saying "My location is [city name]", or share it. <reply><text>📍 Share my location</text><location/></reply></li>
    <li var="lat" value="0">You haven't set your location yet. Tell me by saying "My location is [city name]", or share it. <reply><text>📍 Share my location</text><location/></reply></li>
    <li>
      <!-- Call weather API with stored coordinates -->
      <srai>CALL WEATHER API</srai>
    </li>
  </condition>
</template>
</category>

<category>
<pattern>CALL WEATHER API</pattern>
<template><think><set var="w"><sraix service="weather">{"lat":"<get name="user_latitude"/>","lon":"<get name="user_longitude"/>"}</sraix></set></think><condition var="w"><li value="Weather information is currently unavailable">I can't get the weather right now. Please try again later.</li><li>The weather in <get name="user_location"/> is <weatherformat><get var="w"/></weatherformat></li></condition></template>
</category>

<category>
<pattern>WEATHER</pattern>
<template><srai>WHAT IS THE WEATHER</srai></template>
</category>

<category>
<pattern>WHAT IS THE WEATHER LIKE</pattern>
<template><srai>WHAT IS THE WEATHER</srai></template>
</category>

<category>
<pattern>HOW IS THE WEATHER</pattern>
<template><srai>WHAT IS THE WEATHER</srai></template>
</category>

<!-- Query weather for a specific location -->
<category>
<pattern>WHAT IS THE WEATHER IN *</pattern>
<template>
  <think>
    <!-- Geocode the location -->
    <set var="query_location"><star/></set>
    <set var="query_lat"><sraix service="geocode"><get var="query_location"/></sraix></set>
    <set var="query_lon"><get name="geocode_lon"/></set>
  </think>

  <!-- Check if geocoding succeeded -->
  <condition var="query_lat">
    <li value="Unable to find that location">I couldn't find weather information for <get var="query_location"/>. Please check the location name and try again.</li>
    <li>
      <!-- Call weather API with the queried coordinates, leaving the user's location alone -->
      <think><set var="weather_result"><sraix service="weather">{"lat":"<get var="query_lat"/>","lon":"<get var="query_lon"/>"}</sraix></set></think>
      <condition var="weather_result"><li value="Weather information is currently unavailable">I can't get the weather right now. Please try again later.</li><li>The weather in <get var="query_location"/> is <weatherformat><get var="weather_result"/></weatherformat></li></condition>
    </li>
  </condition>
</template>
</category>

<category>
<pattern>WEATHER IN *</pattern>
<template><srai>WHAT IS THE WEATHER IN <star/></srai></template>
</category>

<category>
<pattern>WHAT IS THE WEATHER LIKE IN *</pattern>
<template><srai>WHAT IS THE WEATHER IN <star/></srai></template>
</category>

<category>
<pattern>HOW IS THE WEATHER IN *</pattern>
<template><srai>WHAT IS THE WEATHER IN <star/></srai></template>
</category>

<!-- Tomorrow's weather queries for user's location -->
<category>
<pattern>WHAT IS THE WEATHER TOMORROW</pattern>
<template>
  <think>

    <set var="lat"><get name="user_latitude"/></set>
    <set var="lon"><get name="user_longitude"/></set>
  </think>

  <condition>
    <li var="lat" value="">You haven't set your location yet. Tell me by saying "My location is [city name]", or share it. <reply><text>📍 Share my location</text><location/></reply></li>
    <li var="lat" value="0.0">You haven't set your location yet. Tell me by saying "My location is [city name]", or share it. <reply><text>📍 Share my location</text><location/></reply></li>
    <li var="lat" value="0">You haven't set your location yet. Tell me by saying "My location is [city name]", or share it. <reply><text>📍 Share my location</text><location/></reply></li>
    <li>
      <think><set var="w"><sraix service="weather">{"lat":"<get var="lat"/>","lon":"<get var="lon"/>"}</sraix></set></think><condition var="w"><li value="Weather information is currently unavailable">I can't get the weather right now. Please try again later.</li><li>In <get name="user_location"/>, <weatherformat day="tomorrow"><get var="w"/></weatherformat></li></condition>
    </li>
  </condition>
</template>
</category>

<category>
<pattern>WHAT WILL THE WEATHER BE TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW</srai></template>
</category>

<category>
<pattern>HOW WILL THE WEATHER BE TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW</srai></template>
</category>

<category>
<pattern>WHAT IS THE WEATHER LIKE TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW</srai></template>
</category>

<category>
<pattern>WEATHER TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW</srai></template>
</category>

<category>
<pattern>TOMORROW WEATHER</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW</srai></template>
</category>

<category>
<pattern>TOMORROW S WEATHER</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW</srai></template>
</category>

<!-- Contraction variations for tomorrow (WHAT S from "what's") -->
<category>
<pattern>WHAT S THE WEATHER TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW</srai></template>
</category>

<category>
<pattern>HOW S THE WEATHER TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW</srai></template>
</category>

<!-- Tomorrow's weather queries for specific locations -->
<category>
<pattern>WHAT IS THE WEATHER TOMORROW IN *</pattern>
<template>
  <think>
    <set var="query_location"><star/></set>
    <set var="query_lat"><sraix service="geocode"><get var="query_location"/></sraix></set>
    <set var="query_lon"><get name="geocode_lon"/></set>
  </think>

  <condition var="query_lat">
    <li value="Unable to find that location">I couldn't find weather information for <get var="query_location"/>. Please check the location name and try again.</li>
    <li>
      <think><set var="weather_result"><sraix service="weather">{"lat":"<get var="query_lat"/>","lon":"<get var="query_lon"/>"}</sraix></set></think>
      <condition var="weather_result"><li value="Weather information is currently unavailable">I can't get the weather right now. Please try again later.</li><li>In <get var="query_location"/>, <weatherformat day="tomorrow"><get var="weather_result"/></weatherformat></li></condition>
    </li>
  </condition>
</template>
</category>

<category>
<pattern>WHAT WILL THE WEATHER BE TOMORROW IN *</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<category>
<pattern>HOW WILL THE WEATHER BE TOMORROW IN *</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<category>
<pattern>WHAT IS THE WEATHER LIKE TOMORROW IN *</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<category>
<pattern>WEATHER TOMORROW IN *</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<category>
<pattern>TOMORROW WEATHER IN *</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<category>
<pattern>TOMORROW S WEATHER IN *</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<!-- Tomorrow's weather with location first (IN * TOMORROW word order) -->
<category>
<pattern>WHAT IS THE WEATHER IN * TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<category>
<pattern>WHAT WILL THE WEATHER BE IN * TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<category>
<pattern>HOW WILL THE WEATHER BE IN * TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<category>
<pattern>WHAT IS THE WEATHER LIKE IN * TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

