</category>

<!-- Contraction variations for location + tomorrow -->
<category>
<pattern>WHAT S THE WEATHER IN * TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
</category>

<category>
<pattern>HOW S THE WEATHER IN * TOMORROW</pattern>
<template><srai>WHAT IS THE WEATHER TOMORROW IN <star/></srai></template>
