</category>

<!-- Weather forecast queries -->
<category>
<pattern>WEATHER FORECAST</pattern>
<template>
  <think>
    <set var="lat"><get name="user_latitude"/></set>
    <set var="lon"><get name="user_longitude"/></set>
  </think>

  <condition>
    <li var="lat" value="">You haven't set your location yet. Tell me by saying "My location is [city name]", or share it. <reply><text>📍 Share my location</text><location/></reply></li>
    <li var="lat" value="0.0">You haven't set your location yet. Tell me by saying "My location is [city name]", or share it. <reply><text>📍 Share my location</text><location/></reply></li>
    <li var="lat" value="0">You haven't set your location yet. Tell me by saying "My location is [city name]", or share it. <reply><text>📍 Share my location</text><location/></reply></li>
    <li>
      <think><set var="w"><sraix service="weather">{"lat":"<get var="lat"/>","lon":"<get var="lon"/>"}</sraix></set></think><condition var="w"><li value="Weather information is currently unavailable">I can't get the weather right now. Please try again later.</li><li>Here's the weather forecast for <get name="user_location"/>: <weatherformat><get var="w"/></weatherformat></li></condition>
    </li>
  </condition>
</template>
</category>

<category>
<pattern>WEATHER FORECAST FOR *</pattern>
<template><srai>WHAT IS THE WEATHER IN <star/></srai></template>
</category>

<!-- Temperature queries -->
<category>
<pattern>WHAT IS THE TEMPERATURE</pattern>
<template><srai>WHAT IS THE WEATHER</srai></template>
</category>

<category>
<pattern>WHAT IS THE TEMPERATURE IN *</pattern>
<template><srai>WHAT IS THE WEATHER IN <star/></srai></template>
</category>

<!-- Location info queries moved to user-location-persistence.aiml for persistence support -->
<!-- The following patterns are now handled by user-location-persistence.aiml:
     - WHAT IS MY LOCATION (checks both session and saved learned patterns)
     - WHERE AM I
-->

<!-- Clear location moved to user-location-persistence.aiml for persistence support -->
<!-- CLEAR MY LOCATION now handled by user-location-persistence.aiml -->
<!-- It redirects to FORGET MY LOCATION which clears both session and saved data -->

</aiml>
