<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
<!--
  Saved list-handler credentials and automatic login

  The credentials live in user_list_username and user_list_password. Like
  every user_* predicate they are saved per user in the user store; the
  password is a secret there, so it is encrypted when USER_STORE_KEY is set
  and hidden from /session. The access token (list_access_token) stays in
  the session only.

  Earlier versions saved credentials with <learnf> as
  "GET LIST PASSWORD FOR <user id>" categories, which any user could match
  to read another user's password. MigrateLegacyUserData moves those into
  the user store at startup and deletes them.
-->

<!-- Logs in with the saved credentials. Leaves list_access_token set on
     success and empty on failure. Silent. -->
<category>
<pattern>LIST LOGIN WITH SAVED CREDENTIALS</pattern>
<template>
  <think>
    <set name="list_access_token"><sraix service="list_login">username=<get name="user_list_username"/>&amp;password=<get name="user_list_password"/></sraix></set>
    <condition name="list_access_token">
      <li value="Login failed. Please check your credentials."><set name="list_access_token"></set></li>
      <li><set name="list_username"><get name="user_list_username"/></set></li>
    </condition>
  </think>
</template>
</category>

<!-- Answered by the list services when the list handler rejects the token
     (it expires after a while): clears it, and logs in again when the user
     has saved credentials. The request is then retried with the new token.
     Without saved credentials the token stays empty, and LIST LOGIN HINT
     says the login has expired. Silent. -->
<category>
<pattern>LIST RELOGIN</pattern>
<template>
  <think>
    <set name="list_access_token"></set>
    <condition name="user_list_username">
      <li value=""><set name="list_login_expired">yes</set></li>
      <li><srai>LIST LOGIN WITH SAVED CREDENTIALS</srai></li>
    </condition>
  </think>
</template>
</category>

<!-- Added to a list command's failure message: explains an expired login -->
<category>
<pattern>LIST LOGIN HINT</pattern>
<template>
  <condition name="list_login_expired">
    <li value="yes"><think><set name="list_login_expired"></set></think>Your list login has expired. Log in again with 'list login USERNAME PASSWORD', or save your credentials with 'save my list credentials USERNAME PASSWORD' and I'll log in again for you when this happens.</li>
    <li></li>
  </condition>
</template>
</category>

<category>
<pattern>SAVE MY LIST CREDENTIALS * *</pattern>
<template>
  <think>
    <set name="user_list_username"><star index="1"/></set>
    <set name="user_list_password"><star index="2"/></set>
    <srai>LIST LOGIN WITH SAVED CREDENTIALS</srai>
  </think>
  <condition name="list_access_token">
    <li value="">I've saved your list credentials, but I couldn't log in with them. Check the username and password, then save them again.</li>
    <li>I've saved your list credentials and logged you in as <get name="user_list_username"/>. List commands will log you in automatically from now on.</li>
  </condition>
</template>
</category>
<category><pattern>SAVE LIST CREDENTIALS * *</pattern><template><srai>SAVE MY LIST CREDENTIALS <star index="1"/> <star index="2"/></srai></template></category>
<category><pattern>STORE MY LIST CREDENTIALS * *</pattern><template><srai>SAVE MY LIST CREDENTIALS <star index="1"/> <star index="2"/></srai></template></category>
<category><pattern>REMEMBER MY LIST CREDENTIALS * *</pattern><template><srai>SAVE MY LIST CREDENTIALS <star index="1"/> <star index="2"/></srai></template></category>

<category>
<pattern>LOAD MY LIST CREDENTIALS</pattern>
<template>
  <condition name="user_list_username">
    <li value="">You haven't saved any list credentials yet. Use 'save my list credentials username password' to store them.</li>
    <li>
      <think><srai>LIST LOGIN WITH SAVED CREDENTIALS</srai></think>
      <condition name="list_access_token">
        <li value="">Unable to log in with your saved credentials. They may have changed; please save them again.</li>
        <li>Logged in as <get name="user_list_username"/> using your saved credentials.</li>
      </condition>
    </li>
  </condition>
</template>
</category>

<!-- Called before every list command: logs in with the saved credentials
     when the session has no token yet. Silent. -->
<category>
<pattern>AUTOLOAD LIST CREDENTIALS</pattern>
<template>
  <think>
    <condition name="list_access_token">
      <li value="">
        <condition name="user_list_username">
          <li value=""></li>
          <li><srai>LIST LOGIN WITH SAVED CREDENTIALS</srai></li>
        </condition>
      </li>
    </condition>
  </think>
</template>
</category>

<category>
<pattern>FORGET MY LIST CREDENTIALS</pattern>
<template>
  <think>
    <set name="user_list_username"></set>
    <set name="user_list_password"></set>
    <set name="list_username"></set>
    <set name="list_access_token"></set>
  </think>
  I've deleted your saved list credentials and logged you out.
</template>
</category>
<category><pattern>CLEAR MY LIST CREDENTIALS</pattern><template><srai>FORGET MY LIST CREDENTIALS</srai></template></category>
<category><pattern>DELETE MY LIST CREDENTIALS</pattern><template><srai>FORGET MY LIST CREDENTIALS</srai></template></category>
<category><pattern>REMOVE MY LIST CREDENTIALS</pattern><template><srai>FORGET MY LIST CREDENTIALS</srai></template></category>

<category>
<pattern>DO I HAVE SAVED LIST CREDENTIALS</pattern>
<template>
  <condition name="user_list_username">
    <li value="">You don't have any saved list credentials. Use 'save my list credentials username password' to store them.</li>
    <li>Yes, you have saved credentials for username <get name="user_list_username"/>. <srai>LIST STATUS</srai></li>
  </condition>
</template>
</category>
<category><pattern>ARE MY LIST CREDENTIALS SAVED</pattern><template><srai>DO I HAVE SAVED LIST CREDENTIALS</srai></template></category>
<category><pattern>LIST CREDENTIALS STATUS</pattern><template><srai>DO I HAVE SAVED LIST CREDENTIALS</srai></template></category>

<category>
<pattern>LIST CREDENTIALS HELP</pattern>
<template>Saved list credentials: 'save my list credentials USERNAME PASSWORD' saves them and logs you in; list commands then log in automatically. 'do I have saved list credentials' checks, and 'forget my list credentials' deletes them. Your password is kept only for you, and I delete the message you typed it in when I can.</template>
</category>

</aiml>
