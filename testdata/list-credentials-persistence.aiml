<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
<!--
  List Handler Credentials Persistence using <learnf>

  This file provides persistent storage of list handler credentials
  keyed by Telegram user ID. Credentials persist across bot restarts
  and enable automatic login without re-entering credentials each time.

  Usage from Telegram bot:
  1. Pass the Telegram user ID as a session variable: "telegram_user"
  2. User saves credentials: "save my list credentials username password"
  3. Bot learns credentials tied to their user ID using <learnf>
  4. Credentials persist in learned_categories/ directory
  5. Auto-login: When user tries list operations, bot auto-logs in

  IMPORTANT: Use Telegram user ID, not username!
  Not all Telegram users have a username (@handle), but every user has a unique ID.

  SECURITY NOTE:
  Credentials are stored in plain text in learned_categories/.
  This is suitable for development/personal use but NOT for production.
  For production, implement proper encryption or use OAuth tokens.

  Example session variable setup in Telegram bot:
    session.Variables["telegram_user"] = fmt.Sprintf("%d", update.Message.From.ID)
-->

<!-- Save list handler credentials with persistence -->
<category>
<pattern>SAVE MY LIST CREDENTIALS * *</pattern>
<template>
  <think>
    <!-- Store in session for immediate use -->
    <set name="list_username"><star index="1"/></set>
    <set name="list_password"><star index="2"/></set>

    <!-- Get the user's Telegram user ID from session -->
    <set var="telegram_user"><get name="telegram_user"/></set>

    <!-- Persist credentials using learnf (if telegram_user is set) -->
    <condition name="telegram_user">
      <li value="">
        <!-- No Telegram user ID - skip persistence -->
      </li>
      <li>
        <!-- Learn username for this specific user -->
        <learnf>
          <category>
            <pattern>GET LIST USERNAME FOR <get var="telegram_user"/></pattern>
            <template><get name="list_username"/></template>
          </category>
        </learnf>
        <!-- Learn password for this specific user -->
        <learnf>
          <category>
            <pattern>GET LIST PASSWORD FOR <get var="telegram_user"/></pattern>
            <template><get name="list_password"/></template>
          </category>
        </learnf>
      </li>
    </condition>
  </think>

  Your list handler credentials have been saved<condition name="telegram_user"> to your profile</condition>. You can now use list commands without logging in manually.
</template>
</category>

<category>
<pattern>SAVE LIST CREDENTIALS * *</pattern>
<template><srai>SAVE MY LIST CREDENTIALS <star index="1"/> <star index="2"/></srai></template>
</category>

<category>
<pattern>STORE MY LIST CREDENTIALS * *</pattern>
<template><srai>SAVE MY LIST CREDENTIALS <star index="1"/> <star index="2"/></srai></template>
</category>

<category>
<pattern>REMEMBER MY LIST CREDENTIALS * *</pattern>
<template><srai>SAVE MY LIST CREDENTIALS <star index="1"/> <star index="2"/></srai></template>
</category>

<!-- Load saved credentials into session and auto-login -->
<category>
<pattern>LOAD MY LIST CREDENTIALS</pattern>
<template>
  <think>
    <set var="telegram_user"><get name="telegram_user"/></set>
  </think>

  <condition var="telegram_user">
    <li value="">
      You need to be logged in via Telegram to load saved credentials.
    </li>
    <li>
      <think>
        <!-- Retrieve saved credentials for this user -->
        <set name="list_username"><srai>GET LIST USERNAME FOR <get var="telegram_user"/></srai></set>
        <set name="list_password"><srai>GET LIST PASSWORD FOR <get var="telegram_user"/></srai></set>
      </think>

      <!-- Check if credentials were found -->
      <condition name="list_username">
        <li value="">
          You haven't saved any list credentials yet. Use 'save my list credentials username password' to store them.
        </li>
        <li>
          <!-- Credentials found, now attempt login -->
          <think>
            <set name="list_access_token"><sraix service="list_login">username=<get name="list_username"/>&amp;password=<get name="list_password"/></sraix></set>
          </think>

          <condition name="list_access_token">
            <li value="Login failed. Please check your credentials.">
              Unable to login with saved credentials. They may be incorrect or expired. Please save new credentials.
            </li>
            <li>
              Logged in successfully as <get name="list_username"/> using your saved credentials.
            </li>
          </condition>
        </li>
      </condition>
    </li>
  </condition>
</template>
</category>

<!-- Auto-load credentials and login if needed (silent operation) -->
<category>
<pattern>AUTOLOAD LIST CREDENTIALS</pattern>
<template>
  <think>
    <!-- Check if already logged in -->
    <set name="_already_logged_in"><condition name="list_access_token">yes</condition></set>

    <!-- Only proceed if NOT already logged in -->
    <condition name="_already_logged_in">
      <li value="yes"><!-- Already logged in, do nothing --></li>
      <li>
        <!-- Not logged in - try to load credentials if telegram_user exists -->
        <set name="_telegram_id"><get name="telegram_user"/></set>
        <condition name="_telegram_id">
          <li value=""><!-- No telegram ID, can't load --></li>
          <li>
            <!-- Try to load saved credentials -->
            <set name="list_username"><srai>GET LIST USERNAME FOR <get name="_telegram_id"/></srai></set>
            <set name="list_password"><srai>GET LIST PASSWORD FOR <get name="_telegram_id"/></srai></set>

            <!-- If credentials exist, attempt login -->
            <condition name="list_username">
              <li value=""><!-- No saved credentials --></li>
              <li>
                <!-- Attempt auto-login -->
                <set name="list_access_token"><sraix service="list_login">username=<get name="list_username"/>&amp;password=<get name="list_password"/></sraix></set>
              </li>
            </condition>
          </li>
        </condition>
      </li>
    </condition>
  </think>
</template>
</category>

<!-- Clear saved credentials -->
<category>
<pattern>FORGET MY LIST CREDENTIALS</pattern>
<template>
  <think>
    <!-- Clear from session -->
    <set name="list_username"></set>
    <set name="list_password"></set>
    <set name="list_access_token"></set>

    <!-- Get telegram_user for checking -->
    <set var="telegram_user"><get name="telegram_user"/></set>
  </think>

  <condition var="telegram_user">
    <li value="">
      Your credentials have been cleared from this session.
    </li>
    <li>
      <think>
        <!-- Unlearn the saved credentials for this user -->
        <unlearnf>
          <category>
            <pattern>GET LIST USERNAME FOR <get var="telegram_user"/></pattern>
            <template>*</template>
          </category>
        </unlearnf>
        <unlearnf>
          <category>
            <pattern>GET LIST PASSWORD FOR <get var="telegram_user"/></pattern>
            <template>*</template>
          </category>
        </unlearnf>
      </think>
      Your list credentials have been cleared from this session and removed from your saved profile. You've been logged out.
    </li>
  </condition>
</template>
</category>

<category>
<pattern>CLEAR MY LIST CREDENTIALS</pattern>
<template><srai>FORGET MY LIST CREDENTIALS</srai></template>
</category>

<category>
<pattern>DELETE MY LIST CREDENTIALS</pattern>
<template><srai>FORGET MY LIST CREDENTIALS</srai></template>
</category>

<category>
<pattern>REMOVE MY LIST CREDENTIALS</pattern>
<template><srai>FORGET MY LIST CREDENTIALS</srai></template>
</category>

<!-- Check credentials status -->
<category>
<pattern>DO I HAVE SAVED LIST CREDENTIALS</pattern>
<template>
  <think>
    <set var="telegram_user"><get name="telegram_user"/></set>
  </think>

  <condition var="telegram_user">
    <li value="">
      You need to be logged in via Telegram to check saved credentials.
    </li>
    <li>
      <think>
        <!-- Try to retrieve saved credentials -->
        <set name="_saved_username"><srai>GET LIST USERNAME FOR <get var="telegram_user"/></srai></set>
      </think>

      <condition name="_saved_username">
        <li value="">
          You don't have any saved list credentials. Use 'save my list credentials username password' to store them.
        </li>
        <li>
          Yes, you have saved credentials for username: <get name="_saved_username"/>. <srai>LIST STATUS</srai>
        </li>
      </condition>
    </li>
  </condition>
</template>
</category>

<category>
<pattern>ARE MY LIST CREDENTIALS SAVED</pattern>
<template><srai>DO I HAVE SAVED LIST CREDENTIALS</srai></template>
</category>

<category>
<pattern>LIST CREDENTIALS STATUS</pattern>
<template><srai>DO I HAVE SAVED LIST CREDENTIALS</srai></template>
</category>

<!-- Catchall patterns for GET commands - returns empty if no learned pattern exists -->
<category>
<pattern>GET LIST USERNAME FOR *</pattern>
<template></template>
</category>

<category>
<pattern>GET LIST PASSWORD FOR *</pattern>
<template></template>
</category>

<!-- Help for credential management -->
<category>
<pattern>LIST CREDENTIALS HELP</pattern>
<template>
  List Credentials Management:

  Save Credentials (persists across restarts):
  - 'save my list credentials [username] [password]'
  - 'store my list credentials [username] [password]'

  Load Credentials (manual login with saved credentials):
  - 'load my list credentials'

  Check Status:
  - 'do I have saved list credentials'
  - 'list credentials status'

  Clear Credentials:
  - 'forget my list credentials'
  - 'clear my list credentials'

  Note: Credentials are automatically loaded when you use list commands, so you don't need to login manually each time!
</template>
</category>

</aiml>
