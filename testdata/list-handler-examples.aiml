<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
    <!-- List Handler API Integration Examples -->

    <!-- Authentication -->
    <category>
        <pattern>LIST LOGIN * *</pattern>
        <template>
            <think>
                <set name="list_username"><star index="1"/></set>
                <set var="login_username"><star index="1"/></set>
                <set var="login_password"><star index="2"/></set>
                <set name="list_access_token"><sraix service="list_login">login</sraix></set>
                <condition name="list_access_token">
                    <li value="Login failed. Please check your credentials."><set name="list_access_token"></set></li>
                </condition>
            </think>
            <condition name="list_access_token">
                <li value="">Unable to login. Please check your username and password.</li>
                <li>
                    Logged in successfully as <get name="list_username"/>. You can now manage your lists.
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST LOGOUT</pattern>
        <template>
            <think>
                <set name="list_username"></set>
                <set name="list_access_token"></set>
            </think>
            Logged out successfully.
        </template>
    </category>

    <!-- Check Login Status -->
    <category>
        <pattern>LIST STATUS</pattern>
        <template>
            <condition name="list_access_token">
                <li value="">You are not logged in. Use 'list login username password' to authenticate.</li>
                <li>You are logged in as <get name="list_username"/>.</li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST WHO AM I</pattern>
        <template>
            <srai>LIST STATUS</srai>
        </template>
    </category>

    <!-- Create List -->
    <category>
        <pattern>LIST CREATE *</pattern>
        <template>
            <think>
                <!-- Try to auto-login with saved credentials if not already logged in -->
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="list_name"><star/></set>
                        <set name="list_description"></set>
                        <set name="create_response"><sraix service="list_create">create</sraix></set>
                    </think>
                    <condition name="create_response">
                        <li value="Failed to create list"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li>I couldn't create a list called "<get name="list_name"/>".</li></condition></li>
                        <li>Created a list called "<get name="list_name"/>".</li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST NEW *</pattern>
        <template>
            <srai>LIST CREATE <star/></srai>
        </template>
    </category>

    <category>
        <pattern>CREATE LIST *</pattern>
        <template>
            <srai>LIST CREATE <star/></srai>
        </template>
    </category>

    <!-- Create List with Description -->
    <category>
        <pattern>LIST CREATE * DESCRIPTION *</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="list_name"><star index="1"/></set>
                        <set name="list_description"><star index="2"/></set>
                        <set name="create_response"><sraix service="list_create">create</sraix></set>
                    </think>
                    <condition name="create_response">
                        <li value="Failed to create list"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li>I couldn't create a list called "<get name="list_name"/>".</li></condition></li>
                        <li>Created a list called "<get name="list_name"/>" (<get name="list_description"/>).</li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <!-- Get All Lists -->
    <category>
        <pattern>LIST SHOW ALL</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="lists_response"><sraix service="list_get_all"></sraix></set>
                    </think>
                    <condition name="lists_response">
                        <li value="Unable to retrieve lists"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li>Unable to retrieve your lists.</li></condition></li>
                        <li><jsonformat type="lists" button="LIST SHOW {list}"><get name="lists_response"/></jsonformat></li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST ALL</pattern>
        <template>
            <srai>LIST SHOW ALL</srai>
        </template>
    </category>

    <category>
        <pattern>SHOW MY LISTS</pattern>
        <template>
            <srai>LIST SHOW ALL</srai>
        </template>
    </category>

    <category>
        <pattern>WHAT LISTS DO I HAVE</pattern>
        <template>
            <srai>LIST SHOW ALL</srai>
        </template>
    </category>

    <!-- Get Specific List with Items -->
    <category>
        <pattern>LIST SHOW *</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="target_list_id"><star/></set>
                        <set name="list_response"><sraix service="list_get"><star/></sraix></set>
                    </think>
                    <condition name="list_response">
                        <li value="List not found"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li><srai>LIST OFFER TO CREATE <get name="target_list_id"/></srai></li></condition></li>
                        <li><jsonformat button="LIST {list} TOGGLE ITEM {id}"><get name="list_response"/></jsonformat></li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>SHOW LIST *</pattern>
        <template>
            <srai>LIST SHOW <star/></srai>
        </template>
    </category>

    <!-- Delete List -->
    <category>
        <pattern>LIST DELETE *</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="delete_list_id"><star/></set>
                        <set name="delete_response"><sraix service="list_delete"><star/></sraix></set>
                    </think>
                    <condition name="delete_response">
                        <li value="Failed to delete list"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li><think><set name="lookup_list_name"><get name="delete_list_id"/></set></think><srai>LIST NOT FOUND</srai></li></condition></li>
                        <li><think><condition name="list_current"><li><value><get name="delete_list_id"/></value><set name="list_current"></set></li></condition></think>Deleted your <get name="delete_list_id"/> list.</li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>DELETE LIST *</pattern>
        <template>
            <srai>LIST DELETE <star/></srai>
        </template>
    </category>

    <category>
        <pattern>REMOVE LIST *</pattern>
        <template>
            <srai>LIST DELETE <star/></srai>
        </template>
    </category>

    <!-- Add Item to List -->
    <category>
        <pattern>LIST * ADD *</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="target_list_id"><star index="1"/></set>
                        <set name="item_content"><star index="2"/></set>
                        <set name="add_response"><sraix service="list_item_add">add</sraix></set>
                    </think>
                    <condition name="add_response">
                        <li value="Failed to add item"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li>
                            <!-- Is it there? If not, offer to create it and add the item -->
                            <think><srai>LIST LOOKUP <get name="target_list_id"/></srai></think>
                            <condition name="list_lookup_status">
                                <li value="missing"><think><set name="pending_add_item"><get name="item_content"/></set></think><srai>LIST OFFER TO CREATE <get name="target_list_id"/></srai></li>
                                <li>I couldn't add "<get name="item_content"/>" to your <get name="target_list_id"/> list.</li>
                            </condition>
                        </li></condition></li>
                        <li><think><srai>LIST USE <get name="target_list_id"/></srai></think>Added "<get name="item_content"/>" to your <get name="target_list_id"/> list.</li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>ADD * TO LIST *</pattern>
        <template>
            <srai>LIST <star index="2"/> ADD <star index="1"/></srai>
        </template>
    </category>

    <!-- Get Items in List -->
    <category>
        <pattern>LIST * ITEMS</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="target_list_id"><star/></set>
                        <set name="items_response"><sraix service="list_item_get"><star/></sraix></set>
                    </think>
                    <condition name="items_response">
                        <li value="Unable to retrieve items"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li>Unable to retrieve items for list <get name="target_list_id"/>.</li></condition></li>
                        <li><jsonformat type="items"><get name="items_response"/></jsonformat></li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>SHOW ITEMS IN LIST *</pattern>
        <template>
            <srai>LIST <star/> ITEMS</srai>
        </template>
    </category>

    <!-- Delete Item from List -->
    <category>
        <pattern>LIST * DELETE ITEM *</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="target_list_id"><star index="1"/></set>
                        <set name="target_item_id"><star index="2"/></set>
                        <set name="delete_item_response"><sraix service="list_item_delete">delete</sraix></set>
                    </think>
                    <condition name="delete_item_response">
                        <li value="Failed to delete item"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li>Unable to delete item <get name="target_item_id"/> from list <get name="target_list_id"/>.</li></condition></li>
                        <li>Deleted item <get name="target_item_id"/> from list <get name="target_list_id"/>.</li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>DELETE ITEM * FROM LIST *</pattern>
        <template>
            <srai>LIST <star index="2"/> DELETE ITEM <star index="1"/></srai>
        </template>
    </category>

    <!-- Toggle Item Completion -->
    <category>
        <pattern>LIST * TOGGLE ITEM *</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="target_list_id"><star index="1"/></set>
                        <set name="target_item_id"><star index="2"/></set>
                        <set name="toggle_response"><sraix service="list_item_toggle">toggle</sraix></set>
                    </think>
                    <condition name="toggle_response">
                        <li value="Failed to toggle item"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li>Unable to toggle item <get name="target_item_id"/> in list <get name="target_list_id"/>.</li></condition></li>
                        <li><srai>LIST SHOW <get name="target_list_id"/></srai></li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>TOGGLE ITEM * IN LIST *</pattern>
        <template>
            <srai>LIST <star index="2"/> TOGGLE ITEM <star index="1"/></srai>
        </template>
    </category>

    <category>
        <pattern>LIST * COMPLETE ITEM *</pattern>
        <template>
            <srai>LIST <star index="1"/> TOGGLE ITEM <star index="2"/></srai>
        </template>
    </category>

    <category>
        <pattern>LIST * MARK ITEM * DONE</pattern>
        <template>
            <srai>LIST <star index="1"/> TOGGLE ITEM <star index="2"/></srai>
        </template>
    </category>

    <!-- Update Item Content -->
    <category>
        <pattern>LIST * UPDATE ITEM * TO *</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
            </think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="target_list_id"><star index="1"/></set>
                        <set name="target_item_id"><star index="2"/></set>
                        <set name="new_content"><star index="3"/></set>
                        <set name="update_response"><sraix service="list_item_update">update</sraix></set>
                    </think>
                    <condition name="update_response">
                        <li value="Failed to update item"><condition name="list_login_expired"><li value="yes"><srai>LIST LOGIN HINT</srai></li><li>Unable to update item <get name="target_item_id"/> in list <get name="target_list_id"/>.</li></condition></li>
                        <li>Updated item <get name="target_item_id"/> in list <get name="target_list_id"/> to '<get name="new_content"/>'.</li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <!-- Items by name: "list groceries check off milk". LIST FIND ITEM looks
         up the item named by item_query in target_list_id (best match
         first, see the list handler's items/search) and sets
         target_item_id and found_item_content. -->
    <category>
        <pattern>LIST FIND ITEM</pattern>
        <template>
            <think>
                <set name="found_item_content"></set>
                <set name="target_item_id"><sraix service="list_item_find">find</sraix></set>
                <condition name="target_item_id">
                    <li value="Item not found"><set name="target_item_id"></set></li>
                </condition>
            </think>
        </template>
    </category>

    <!-- What to say when LIST FIND ITEM found nothing -->
    <category>
        <pattern>LIST ITEM NOT FOUND</pattern>
        <template>
            <condition name="list_login_expired">
                <li value="yes"><srai>LIST LOGIN HINT</srai></li>
                <li>
                    <think><srai>LIST LOOKUP <get name="target_list_id"/></srai></think>
                    <condition name="list_lookup_status">
                        <li value="missing"><srai>LIST NOT FOUND</srai></li>
                        <li><think><set name="list_current"><get name="found_list_name"/></set></think>I couldn't find "<get name="item_query"/>" on your <get name="target_list_id"/> list.</li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST * CHECK OFF *</pattern>
        <template>
            <think><srai>AUTOLOAD LIST CREDENTIALS</srai></think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="target_list_id"><star index="1"/></set>
                        <set name="item_query"><star index="2"/></set>
                        <srai>LIST FIND ITEM</srai>
                    </think>
                    <condition name="target_item_id">
                        <li value=""><srai>LIST ITEM NOT FOUND</srai></li>
                        <li>
                            <think>
                                <set name="item_done">1</set>
                                <set var="result"><sraix service="list_item_set_done">done</sraix></set>
                            </think>
                            <condition var="result">
                                <li value="Failed to update item">I found "<get name="found_item_content"/>" but couldn't tick it off.</li>
                                <li><think><srai>LIST USE <get name="target_list_id"/></srai></think>Ticked off "<get name="found_item_content"/>" on your <get name="target_list_id"/> list.</li>
                            </condition>
                        </li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST * UNCHECK *</pattern>
        <template>
            <think><srai>AUTOLOAD LIST CREDENTIALS</srai></think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="target_list_id"><star index="1"/></set>
                        <set name="item_query"><star index="2"/></set>
                        <srai>LIST FIND ITEM</srai>
                    </think>
                    <condition name="target_item_id">
                        <li value=""><srai>LIST ITEM NOT FOUND</srai></li>
                        <li>
                            <think>
                                <set name="item_done">0</set>
                                <set var="result"><sraix service="list_item_set_done">not done</sraix></set>
                            </think>
                            <condition var="result">
                                <li value="Failed to update item">I found "<get name="found_item_content"/>" but couldn't untick it.</li>
                                <li><think><srai>LIST USE <get name="target_list_id"/></srai></think>Unticked "<get name="found_item_content"/>" on your <get name="target_list_id"/> list.</li>
                            </condition>
                        </li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST * REMOVE *</pattern>
        <template>
            <think><srai>AUTOLOAD LIST CREDENTIALS</srai></think>
            <condition name="list_access_token">
                <li value="">Please login first using 'list login username password' or save credentials with 'save my list credentials username password'</li>
                <li>
                    <think>
                        <set name="target_list_id"><star index="1"/></set>
                        <set name="item_query"><star index="2"/></set>
                        <srai>LIST FIND ITEM</srai>
                    </think>
                    <condition name="target_item_id">
                        <li value=""><srai>LIST ITEM NOT FOUND</srai></li>
                        <li>
                            <think><set var="result"><sraix service="list_item_delete">delete</sraix></set></think>
                            <condition var="result">
                                <li value="Failed to delete item">I found "<get name="found_item_content"/>" but couldn't remove it.</li>
                                <li><think><srai>LIST USE <get name="target_list_id"/></srai></think>Removed "<get name="found_item_content"/>" from your <get name="target_list_id"/> list.</li>
                            </condition>
                        </li>
                    </condition>
                </li>
            </condition>
        </template>
    </category>

    <category><pattern>CHECK OFF * ON LIST *</pattern><template><srai>LIST <star index="2"/> CHECK OFF <star/></srai></template></category>
    <category><pattern>CROSS OFF * ON LIST *</pattern><template><srai>LIST <star index="2"/> CHECK OFF <star/></srai></template></category>
    <category><pattern>LIST * CROSS OFF *</pattern><template><srai>LIST <star/> CHECK OFF <star index="2"/></srai></template></category>
    <category><pattern>UNCHECK * ON LIST *</pattern><template><srai>LIST <star index="2"/> UNCHECK <star/></srai></template></category>
    <category><pattern>REMOVE * FROM LIST *</pattern><template><srai>LIST <star index="2"/> REMOVE <star/></srai></template></category>

    <!-- ============================================================ -->
    <!-- Lists that may not be there                                  -->
    <!-- ============================================================ -->

    <!-- LIST LOOKUP <name> finds the user's list by name. The list handler
         ignores case, plurals, "my"/"the" and a trailing "list", so
         "Grocery" finds "groceries". Sets list_lookup_status to found,
         missing or login (not logged in, or the login has expired), and
         found_list_name to the list's real name. Says nothing. -->
    <category>
        <pattern>LIST LOOKUP *</pattern>
        <template>
            <think>
                <srai>AUTOLOAD LIST CREDENTIALS</srai>
                <set name="lookup_list_name"><star/></set>
                <set name="found_list_name"></set>
                <condition name="list_access_token">
                    <li value=""><set name="list_lookup_status">login</set></li>
                    <li>
                        <set name="found_list_name"><sraix service="list_lookup">lookup</sraix></set>
                        <condition name="found_list_name">
                            <li value="List not found">
                                <set name="found_list_name"></set>
                                <condition name="list_login_expired">
                                    <li value="yes"><set name="list_lookup_status">login</set></li>
                                    <li><set name="list_lookup_status">missing</set></li>
                                </condition>
                            </li>
                            <li><set name="list_lookup_status">found</set></li>
                        </condition>
                    </li>
                </condition>
            </think>
        </template>
    </category>

    <!-- LIST USE <name>: after a change to the list typed as <name>, makes
         it the list in use (list_current) under its real name, and sets
         target_list_id to that name for the reply. It looks the name up
         only when it isn't the list already in use. -->
    <category>
        <pattern>LIST USE *</pattern>
        <template>
            <think>
                <condition name="list_current">
                    <li><value><star/></value></li>
                    <li>
                        <srai>LIST LOOKUP <star/></srai>
                        <condition name="list_lookup_status">
                            <li value="found"><set name="list_current"><get name="found_list_name"/></set></li>
                            <li><set name="list_current"><star/></set></li>
                        </condition>
                    </li>
                </condition>
                <set name="target_list_id"><get name="list_current"/></set>
            </think>
        </template>
    </category>

    <!-- After LIST LOOKUP found nothing: says so, with a button for each
         list the user has and one to create the list -->
    <category>
        <pattern>LIST NOT FOUND</pattern>
        <template>
            <think><set var="lists"><sraix service="list_get_all"></sraix></set></think>
            <condition var="lists">
                <li value="[]">You don't have a list called "<get name="lookup_list_name"/>". You have no lists yet.</li>
                <li value="Unable to retrieve lists">You don't have a list called "<get name="lookup_list_name"/>".</li>
                <li>You don't have a list called "<get name="lookup_list_name"/>". Here are the lists you have:<jsonformat type="lists" button="LIST SHOW {list}" only="buttons"><get var="lists"/></jsonformat></li>
            </condition>
            <button><text>➕ Create "<get name="lookup_list_name"/>"</text><postback>LIST CREATE <get name="lookup_list_name"/></postback></button>
        </template>
    </category>

    <!-- For "Which list should I add ... to?": a button for each list,
         which adds pending_add_item to it -->
    <category>
        <pattern>LIST CHOICE BUTTONS</pattern>
        <template>
            <think><srai>AUTOLOAD LIST CREDENTIALS</srai></think>
            <condition name="list_access_token">
                <li value=""></li>
                <li><think><set var="lists"><sraix service="list_get_all"></sraix></set></think><condition var="lists"><li value="Unable to retrieve lists"></li><li><jsonformat type="lists" button="LIST ADD PENDING TO {list}" only="buttons"><get var="lists"/></jsonformat></li></condition></li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST ADD PENDING TO *</pattern>
        <template>
            <think>
                <set var="item"><get name="pending_add_item"/></set>
                <set name="pending_add_item"></set>
            </think>
            <condition var="item">
                <li value="">What should I add to your <star/> list?</li>
                <li><srai>LIST <star/> ADD <get var="item"/></srai></li>
            </condition>
        </template>
    </category>

    <!-- "You don't have a list called X. Should I create it?" With
         pending_add_item set, it offers to add that item too. The buttons
         come first, so that golem versions whose <that> still sees button
         markup match the question too. -->
    <category>
        <pattern>LIST OFFER TO CREATE *</pattern>
        <template>
            <think><set name="pending_create_list"><star/></set></think>
            <condition name="pending_add_item">
                <li value=""><button><text>Yes, create it</text><postback>LIST CONFIRM CREATE</postback></button><button><text>No</text><postback>LIST CANCEL CREATE</postback></button> You don't have a list called "<star/>". Should I create it?</li>
                <li><button><text>Yes, create it</text><postback>LIST CONFIRM CREATE</postback></button><button><text>No</text><postback>LIST CANCEL CREATE</postback></button> You don't have a list called "<star/>" yet. Should I create it and add "<get name="pending_add_item"/>" to it?</li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST CONFIRM CREATE</pattern>
        <template>
            <think>
                <set var="name"><get name="pending_create_list"/></set>
                <set var="item"><get name="pending_add_item"/></set>
                <set name="pending_create_list"></set>
                <set name="pending_add_item"></set>
            </think>
            <condition var="name">
                <li value="">There's no list waiting to be created.</li>
                <li>
                    <think><set var="created"><srai>LIST CREATE <get var="name"/></srai></set></think>
                    <condition var="item"><li value=""><think><set name="list_current"><get var="name"/></set></think><get var="created"/></li><li><get var="created"/> <srai>LIST <get var="name"/> ADD <get var="item"/></srai></li></condition>
                </li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST CANCEL CREATE</pattern>
        <template>
            <think>
                <set name="pending_create_list"></set>
                <set name="pending_add_item"></set>
            </think>
            Okay, I won't create it.
        </template>
    </category>

    <category><pattern>YES</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CONFIRM CREATE</srai></template></category>
    <category><pattern>YES PLEASE</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CONFIRM CREATE</srai></template></category>
    <category><pattern>YEAH</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CONFIRM CREATE</srai></template></category>
    <category><pattern>YEP</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CONFIRM CREATE</srai></template></category>
    <category><pattern>SURE</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CONFIRM CREATE</srai></template></category>
    <category><pattern>OK</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CONFIRM CREATE</srai></template></category>
    <category><pattern>OKAY</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CONFIRM CREATE</srai></template></category>
    <category><pattern>CREATE IT</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CONFIRM CREATE</srai></template></category>
    <category><pattern>NO</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CANCEL CREATE</srai></template></category>
    <category><pattern>NOPE</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CANCEL CREATE</srai></template></category>
    <category><pattern>NO THANKS</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CANCEL CREATE</srai></template></category>
    <category><pattern>DO NOT</pattern><that>^ SHOULD I CREATE IT ^</that><template><srai>LIST CANCEL CREATE</srai></template></category>

    <!-- Help -->
    <category>
        <pattern>LIST HELP</pattern>
        <template>
            List Handler Commands:

            Authentication:
            - 'list login username password' - Login to list handler
            - 'list logout' - Logout
            - 'list status' - Check login status

            List Management:
            - 'list create [name]' - Create a new list
            - 'list create [name] description [desc]' - Create list with description
            - 'list show all' / 'show my lists' - Show all your lists
            - 'list show [name]' - Show a list with its items
            - 'list delete [name]' - Delete a list

            Item Management:
            - 'list [name] add [content]' - Add item to list
            - 'list [name] check off [item]' - Tick off an item by name ('list [name] uncheck [item]' to untick)
            - 'list [name] remove [item]' - Remove an item by name
            - 'list [name] items' - Show all items in list
            - 'list [id] delete item [item_id]' - Delete item from list
            - 'list [id] toggle item [item_id]' - Toggle item completion
            - 'list [id] update item [item_id] to [content]' - Update item content
        </template>
    </category>

    <category>
        <pattern>LIST HANDLER HELP</pattern>
        <template>
            <srai>LIST HELP</srai>
        </template>
    </category>

    <!-- Status Check -->
    <category>
        <pattern>IS LIST HANDLER ENABLED</pattern>
        <template>
            <condition name="bot.listhandler.enabled">
                <li value="true">Yes, List Handler integration is enabled. Server: <bot name="listhandler.server"/>. <srai>LIST STATUS</srai></li>
                <li>List Handler integration is not currently enabled.</li>
            </condition>
        </template>
    </category>

    <category>
        <pattern>LIST HANDLER STATUS</pattern>
        <template>
            <srai>IS LIST HANDLER ENABLED</srai>
        </template>
    </category>

</aiml>
